{
  "agents": [
    {"id": "ollama", "label": "Ollama (local)", "kind": "ollama",
     "url": "http://127.0.0.1:11434", "model": "llama3.2:3b"},

    {"id": "codex", "label": "Codex (ChatGPT plan)", "kind": "command",
     "command": ["codex", "exec", "--skip-git-repo-check", "{prompt}"], "timeout": 300},

    {"id": "devin", "label": "Devin (ACP)", "kind": "acp",
     "command": ["devin", "acp"], "timeout": 300},

    {"id": "opencode", "label": "OpenCode", "kind": "command",
     "command": ["opencode", "run", "{prompt}"], "timeout": 300},

    {"id": "openai", "label": "OpenAI API (key)", "kind": "openai",
     "base_url": "https://api.openai.com/v1", "model": "gpt-4o-mini", "key": "pass:openai"}
  ]
}
